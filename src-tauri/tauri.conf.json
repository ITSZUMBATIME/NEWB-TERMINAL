{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEWB",
  "version": "0.1.0",
  "identifier": "io.github.itszumbatime.newb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NEWB",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A terminal for people who are new to the terminal",
    "longDescription": "NEWB is a friendly terminal for people who are new to the command line: a plain-English cheat sheet you can drag commands from, a file panel, a built-in editor, git buttons, themes, and optional AI helpers. Everything is off or plain until you turn it on.",
    "publisher": "ITSZUMBATIME",
    "copyright": "MIT licence",
    "license": "MIT",
    "homepage": "https://github.com/ITSZUMBATIME/NEWB-TERMINAL",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "epoch": 0,
        "release": "1"
      }
    }
  }
}
